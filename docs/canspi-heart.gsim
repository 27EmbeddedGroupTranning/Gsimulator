# CANSPI 示例固件的演示接线（firmware/CANSPI/build/Debug/CANSPI.elf）
#
#   cargo run -p gsimulator-gui
#   -> 「📂 打开工程…」选这个文件，再「加载 ELF…」选 CANSPI.elf，然后「运行」
#
# SPI1 引脚：PA5 = SCK、PA7 = MOSI（DIN）、PA6 = MISO（DOUT）、PA4 = 软件片选 LOAD。
# 灯阵要接 VCC/GND 才工作；HSE 晶振接在 PD0/PD1 上，固件用 8 MHz × 9 = 72 MHz。
#
# CAN1 用 PA12 = TX、PA11 = RX 经收发器接上总线对；电机与两个 120 Ω 终端电阻跨接在
# CANH/CANL 上。固件每半个心跳周期发一帧 0x200（大端 int16 rpm），电机跟着正转/滑行/反转。
gsimulator project 1
device 1 vcc -140.00 60.00
device 2 gnd -140.00 620.00
device 3 matrix 520.00 -40.00
device 4 hse -260.00 150.00
device 5 can 520.00 330.00 mode=normal
device 6 motor 760.00 470.00 cmd=0x200
device 7 resistor 900.00 330.00 ohms=120
device 8 resistor 900.00 560.00 ohms=120
wire dev:3:0 mcu:0:7
wire dev:3:1 mcu:0:5
wire dev:3:2 mcu:0:4
wire dev:3:3 mcu:0:6
wire dev:3:4 dev:1:0
wire dev:3:5 dev:2:0
wire dev:4:0 mcu:3:0
wire dev:4:1 mcu:3:1
wire dev:5:0 mcu:0:12
wire dev:5:1 mcu:0:11
wire dev:5:2 dev:6:0
wire dev:5:3 dev:6:1
wire dev:5:4 dev:1:0
wire dev:5:5 dev:2:0
wire dev:6:2 dev:1:0
wire dev:6:3 dev:2:0
wire dev:7:0 dev:5:2
wire dev:7:1 dev:5:3
wire dev:8:0 dev:5:2
wire dev:8:1 dev:5:3
